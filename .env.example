# ============================================================
# Vercel 환경 변수 (Vercel Dashboard > Settings > Environment Variables 에 입력)
# 로컬 테스트 시: .env.local 파일에 동일 키 값으로 복사
# ============================================================

# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Resend (이메일 발송) ────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── 이메일 설정 ──────────────────────────────────────────────
# FROM_EMAIL: Resend에 인증된 도메인의 발신 주소
FROM_EMAIL=noreply@your-domain.com

# SALES_NOTIFY_EMAIL: 영업팀이 리드 알림 받을 주소
SALES_NOTIFY_EMAIL=sales@your-domain.com

# ── 장애 알림 (선택) ────────────────────────────────────────
# Supabase 저장이 실패하면 방문자에게는 정상 접수로 응답하고, 운영 담당에게만 알람을 보낸다.
# 영업팀은 장애와 무관하게 평소 리드 알림 메일을 그대로 받는다.
# 알림 메일 본문에 리드 원본 JSON이 담기므로 메일함이 최후의 백업 역할을 한다.

# ALERT_NOTIFY_EMAIL: 장애 알림 수신 주소(운영 담당). 쉼표로 여러 명 지정 가능.
#                     영업팀(SALES_NOTIFY_EMAIL)으로 폴백하지 않는다 — 미설정이면
#                     장애 알림 메일을 아예 보내지 않고 로그로만 남긴다.
ALERT_NOTIFY_EMAIL=dev@your-domain.com


# ── Supabase 유지용 Cron (api/keepalive.js) ─────────────────
# 무료 플랜은 7일간 요청이 없으면 자동 정지된다. vercel.json 의 crons 가
# 매일 1회 /api/keepalive 를 호출해 정지를 막고, 성공·실패 결과를
# ALERT_NOTIFY_EMAIL 로 보고한다. 성공 메일은 하트비트 역할도 한다 —
# 메일이 오지 않는 것 자체가 크론 미실행 신호.

# CRON_SECRET: 설정하면 Vercel Cron 호출만 허용 (외부에서 임의 호출 차단).
#              Vercel 이 Authorization: Bearer <값> 헤더를 자동으로 붙여 보낸다.
# CRON_SECRET=랜덤한_긴_문자열

# ── Meta CAPI (선택, 서버사이드 전환 추적) ──────────────────
# META_PIXEL_ID=1234567890123456
# META_CAPI_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxx
