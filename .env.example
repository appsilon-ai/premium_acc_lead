# ============================================================
# Vercel 환경 변수 (Vercel Dashboard > Settings > Environment Variables 에 입력)
# 로컬 테스트 시: .env.local 파일에 동일 키 값으로 복사
# ============================================================

# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Resend (이메일 발송) ────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── 이메일 설정 ──────────────────────────────────────────────
# FROM_EMAIL: Resend에 인증된 도메인의 발신 주소
FROM_EMAIL=noreply@your-domain.com

# SALES_NOTIFY_EMAIL: 영업팀이 리드 알림 받을 주소
SALES_NOTIFY_EMAIL=sales@your-domain.com

# ── Meta CAPI (선택, 서버사이드 전환 추적) ──────────────────
# META_PIXEL_ID=1234567890123456
# META_CAPI_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxx
